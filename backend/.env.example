# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to GitHub - it contains sensitive information

# ========================================
# DATABASE CONFIGURATION (Railway)
# ========================================
DB_HOST=junction.proxy.rlwy.net
DB_PORT=42468
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=railway

# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=3000
NODE_ENV=development

# ========================================
# NOTES
# ========================================
# - DB credentials: Get from your Railway dashboard
# - PORT: Can be changed if needed (default 3000)
# - NODE_ENV: Use 'development' locally, 'production' on Render
